# Mock Mode (True = Use mock data, False = Use live APIs)
USE_MOCK_FALLBACK=True

# Google Cloud Project ID (for DLP)
GOOGLE_CLOUD_PROJECT=your_project_id

# API Keys
GEMINI_API_KEY=your_gemini_api_key
EKISPERT_API_KEY=your_ekispert_api_key

# Ekispert MCP Server URL
EKISPERT_MCP_URL=http://localhost:8000

# Backend Server Port
PORT=8080
